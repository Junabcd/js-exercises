# サプライチェーン攻撃対策のため npm 12 以上を強制する (package.json の engines を参照)。
# npm 12 は依存パッケージの install script が承認制になる、git やリモート tarball の
# 依存インストールが既定で無効になるなど、セキュリティの既定値が強化されている。
engine-strict=true

# Dependency cooldown: 公開から3日未満のバージョンはインストールしない。
# 侵害されたパッケージは公開から数日以内に発見・削除されることが多いため、
# 公開直後のバージョンを避けることでサプライチェーン攻撃のリスクを下げる。
# 特定パッケージを除外したい場合は min-release-age-exclude を使う。
min-release-age=3
